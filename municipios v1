# Función para crear conexiones
def crear_conexiones(municipios, num_conexiones=3):
    conexiones = []
    for origen, coord_origen in municipios.items():
        distancias = [(destino, distancia_haversine(coord_origen, coord_destino))
                      for destino, coord_destino in municipios.items() if destino != origen]
        distancias.sort(key=lambda x: x[1])
        for destino, distancia in distancias[:num_conexiones]:
            conexiones.append((origen, destino, distancia))
    return conexiones
def distancia_haversine(coord1, coord2):
    R = 6371  # Radio de la Tierra en km
    lat1, lon1 = coord1
    lat2, lon2 = coord2
    lat1, lon1, lat2, lon2 = map(radians, [lat1, lon1, lat2, lon2])
    dlat = lat2 - lat1
    dlon = lon2 - lon1
    a = sin(dlat/2)**2 + cos(lat1) * cos(lat2) * sin(dlon/2)**2
    c = 2 * atan2(sqrt(a), sqrt(1-a))
    return R * c
def crear_grafo(conexiones):
    grafo = defaultdict(dict)
    for origen, destino, distancia in conexiones:
        grafo[origen][destino] = distancia
        grafo[destino][origen] = distancia
    return grafo

def busqueda_voraz(grafo, inicio, fin):
    actual = inicio
    camino = [actual]
    costo_total = 0
    visitados = set([actual])
    
    while actual != fin:
        if actual not in grafo:
            return None, float('inf')
        
        # Encuentra el vecino más cercano no visitado
        vecino_mas_cercano = None
        distancia_minima = float('inf')
        for vecino, distancia in grafo[actual].items():
            if vecino not in visitados and distancia < distancia_minima:
                vecino_mas_cercano = vecino
                distancia_minima = distancia
        
        if vecino_mas_cercano is None:
            # No hay camino al destino
            return None, float('inf')
        
        costo_total += distancia_minima
        camino.append(vecino_mas_cercano)
        visitados.add(vecino_mas_cercano)
        actual = vecino_mas_cercano
    
    return camino, costo_total

def a_estrella(grafo, inicio, fin):
    def heuristica(nodo):
        return distancia_haversine(municipios[nodo], municipios[fin])

    frontera = [(0, inicio)]
    vino_de = {}
    costo_g = {inicio: 0}

    while frontera:
        _, actual = heapq.heappop(frontera)

        if actual == fin:
            camino = []
            while actual in vino_de:
                camino.append(actual)
                actual = vino_de[actual]
            camino.append(inicio)
            return list(reversed(camino)), costo_g[fin]

        for vecino, distancia in grafo[actual].items():
            nuevo_costo = costo_g[actual] + distancia
            if vecino not in costo_g or nuevo_costo < costo_g[vecino]:
                costo_g[vecino] = nuevo_costo
                prioridad = nuevo_costo + heuristica(vecino)
                heapq.heappush(frontera, (prioridad, vecino))
                vino_de[vecino] = actual

    return None, float('inf')

def bellman_ford(grafo, inicio, fin):
    distancias = {municipio: float('inf') for municipio in grafo}
    distancias[inicio] = 0
    vino_de = {}

    for _ in range(len(grafo) - 1):
        for municipio in grafo:
            for vecino, peso in grafo[municipio].items():
                if distancias[municipio] + peso < distancias[vecino]:
                    distancias[vecino] = distancias[municipio] + peso
                    vino_de[vecino] = municipio

    # Verificar ciclos negativos
    for municipio in grafo:
        for vecino, peso in grafo[municipio].items():
            if distancias[municipio] + peso < distancias[vecino]:
                print("El grafo contiene un ciclo de peso negativo")
                return None, float('inf')

    # Reconstruir el camino
    if fin not in vino_de and inicio != fin:
        return None, float('inf')

    camino = []
    actual = fin
    while actual != inicio:
        camino.append(actual)
        actual = vino_de[actual]
    camino.append(inicio)
    
    return list(reversed(camino)), distancias[fin]

def dijkstra(grafo, inicio, fin):
    distancias = {municipio: float('inf') for municipio in grafo}
    distancias[inicio] = 0
    vino_de = {}
    cola = [(0, inicio)]

    while cola:
        distancia_actual, municipio_actual = heapq.heappop(cola)

        if municipio_actual == fin:
            camino = []
            while municipio_actual in vino_de:
                camino.append(municipio_actual)
                municipio_actual = vino_de[municipio_actual]
            camino.append(inicio)
            return list(reversed(camino)), distancias[fin]

        if distancia_actual > distancias[municipio_actual]:
            continue

        for vecino, peso in grafo[municipio_actual].items():
            distancia = distancia_actual + peso
            if distancia < distancias[vecino]:
                distancias[vecino] = distancia
                vino_de[vecino] = municipio_actual
                heapq.heappush(cola, (distancia, vecino))

    return None, float('inf')
def kruskal(grafo):
    def find(parent, i):
        if parent[i] == i:
            return i
        return find(parent, parent[i])

    def union(parent, rank, x, y):
        xroot = find(parent, x)
        yroot = find(parent, y)
        if rank[xroot] < rank[yroot]:
            parent[xroot] = yroot
        elif rank[xroot] > rank[yroot]:
            parent[yroot] = xroot
        else:
            parent[yroot] = xroot
            rank[xroot] += 1

    aristas = []
    for u in grafo:
        for v, peso in grafo[u].items():
            aristas.append((u, v, peso))
    
    aristas.sort(key=lambda x: x[2])
    
    vertices = list(grafo.keys())
    parent = {v: v for v in vertices}
    rank = {v: 0 for v in vertices}
    
    arbol_expansion_minima = []
    
    for u, v, peso in aristas:
        x = find(parent, u)
        y = find(parent, v)
        if x != y:
            arbol_expansion_minima.append((u, v, peso))
            union(parent, rank, x, y)
    
    return arbol_expansion_minima

def prim(grafo):
    vertices = list(grafo.keys())
    inicio = vertices[0]
    visitados = set([inicio])
    aristas = [(peso, inicio, v) for v, peso in grafo[inicio].items()]
    heapq.heapify(aristas)
    arbol_expansion_minima = []

    while aristas:
        peso, u, v = heapq.heappop(aristas)
        if v not in visitados:
            visitados.add(v)
            arbol_expansion_minima.append((u, v, peso))
            for siguiente, peso in grafo[v].items():
                if siguiente not in visitados:
                    heapq.heappush(aristas, (peso, v, siguiente))

    return arbol_expansion_minima

def crear_mapa(municipios, conexiones, rutas, arbol_expansion_minima):
    mapa = folium.Map(location=[4.570868, -74.297333], zoom_start=6)

    for municipio, coords in municipios.items():
        folium.Marker(
            coords,
            popup=municipio,
            icon=folium.Icon(color='blue', icon='info-sign')
        ).add_to(mapa)

    for origen, destino, _ in conexiones:
        folium.PolyLine(
            locations=[municipios[origen], municipios[destino]],
            color="gray",
            weight=2,
            opacity=0.5
        ).add_to(mapa)

    colores = {
        'Búsqueda Voraz': 'red',
        'A*': 'blue',
        'Bellman-Ford': 'green',
        'Dijkstra': 'purple',
        'Árbol de Expansión Mínima': 'orange'
    }

    for nombre, (ruta, _) in rutas.items():
        if ruta:
            coordenadas_ruta = [municipios[municipio] for municipio in ruta]
            folium.PolyLine(
                coordenadas_ruta,
                color=colores[nombre],
                weight=4,
                opacity=0.8,
                popup=nombre
            ).add_to(mapa)

    for u, v, _ in arbol_expansion_minima:
        folium.PolyLine(
            [municipios[u], municipios[v]],
            color=colores['Árbol de Expansión Mínima'],
            weight=4,
            opacity=0.8,
            popup='Árbol de Expansión Mínima'
        ).add_to(mapa)

    folium.Marker(
        municipios[ruta[0]],
        popup="Inicio: Bogotá",
        icon=folium.Icon(color='green', icon='play')
    ).add_to(mapa)
    folium.Marker(
        municipios[ruta[-1]],
        popup=f"Fin: {ruta[-1]}",
        icon=folium.Icon(color='red', icon='stop')
    ).add_to(mapa)

    minimap = plugins.MiniMap()
    mapa.add_child(minimap)
    folium.LayerControl().add_to(mapa)
    mapa.save("mapa_colombia.html")

